{
  "name": "qubase",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop SQL client (Electron + React)",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@clickhouse/client": "^1.24.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/view": "^6.43.15",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@google-cloud/bigquery": "^9.6.1",
    "@libsql/client": "^0.18.0",
    "@uiw/react-codemirror": "^4.23.0",
    "better-sqlite3": "^11.8.0",
    "cassandra-driver": "^4.10.0",
    "exceljs": "^4.4.0",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.12.0",
    "oracledb": "^26.0.0",
    "pg": "^8.13.0",
    "pg-cursor": "^2.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.1",
    "snowflake-sdk": "^3.4.1",
    "sql-formatter": "^15.9.0",
    "ssh2": "^1.17.0",
    "trino-client": "^0.2.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.qubase.desktop",
    "productName": "Qubase",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png",
      "!**/node_modules/cpu-features/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@duckdb/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Qubase-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qubase"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
